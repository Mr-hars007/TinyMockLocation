<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/colorBackground"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:paddingTop="28dp"
        android:paddingBottom="20dp">

        <!-- Title -->
        <TextView
            android:id="@+id/tvTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Mock Location"
            android:textSize="24sp"
            android:textColor="@color/colorTextPrimary"
            android:fontFamily="sans-serif-medium"
            android:layout_marginBottom="24dp" />

        <!-- Plus Code -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Plus Code"
            android:textSize="13sp"
            android:textColor="@color/colorTextSecondary"
            android:layout_marginBottom="6dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="16dp">

            <EditText
                android:id="@+id/etPlusCode"
                android:layout_width="0dp"
                android:layout_height="46dp"
                android:layout_weight="1"
                android:hint="7X7X7X7X+7X"
                android:inputType="textCapCharacters|textNoSuggestions"
                android:textSize="15sp"
                android:textColor="@color/colorInputText"
                android:textColorHint="@color/colorHint"
                android:background="@color/colorInputBg"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:gravity="center_vertical" />

            <Button
                android:id="@+id/btnDecodePlusCode"
                android:layout_width="wrap_content"
                android:layout_height="46dp"
                android:text="Decode"
                android:textSize="13sp"
                android:textColor="#FFFFFF"
                android:textAllCaps="false"
                android:background="@color/colorPrimary"
                android:layout_marginStart="10dp"
                android:paddingStart="16dp"
                android:paddingEnd="16dp" />
        </LinearLayout>

        <!-- Latitude -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Latitude"
            android:textSize="13sp"
            android:textColor="@color/colorTextSecondary"
            android:layout_marginBottom="6dp" />

        <EditText
            android:id="@+id/etLatitude"
            android:layout_width="match_parent"
            android:layout_height="46dp"
            android:hint="0.000000"
            android:inputType="numberSigned|numberDecimal"
            android:textSize="15sp"
            android:textColor="@color/colorInputText"
            android:textColorHint="@color/colorHint"
            android:background="@color/colorInputBg"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:gravity="center_vertical"
            android:layout_marginBottom="16dp" />

        <!-- Longitude -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Longitude"
            android:textSize="13sp"
            android:textColor="@color/colorTextSecondary"
            android:layout_marginBottom="6dp" />

        <EditText
            android:id="@+id/etLongitude"
            android:layout_width="match_parent"
            android:layout_height="46dp"
            android:hint="0.000000"
            android:inputType="numberSigned|numberDecimal"
            android:textSize="15sp"
            android:textColor="@color/colorInputText"
            android:textColorHint="@color/colorHint"
            android:background="@color/colorInputBg"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:gravity="center_vertical"
            android:layout_marginBottom="22dp" />

        <!-- Start / Stop -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="16dp">

            <Button
                android:id="@+id/btnStart"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:text="Start"
                android:textSize="15sp"
                android:textColor="@color/colorBtnStartText"
                android:textAllCaps="false"
                android:fontFamily="sans-serif-medium"
                android:background="@color/colorBtnStart"
                android:layout_marginEnd="6dp" />

            <Button
                android:id="@+id/btnStop"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:text="Stop"
                android:textSize="15sp"
                android:textColor="@color/colorBtnStopText"
                android:textAllCaps="false"
                android:fontFamily="sans-serif-medium"
                android:background="@color/colorBtnStop"
                android:layout_marginStart="6dp" />
        </LinearLayout>

        <!-- Status -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="22dp">

            <View
                android:id="@+id/statusDot"
                android:layout_width="8dp"
                android:layout_height="8dp"
                android:background="@color/colorStopped"
                android:layout_marginEnd="8dp" />

            <TextView
                android:id="@+id/tvStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Stopped"
                android:textSize="14sp"
                android:textColor="@color/colorTextSecondary" />
        </LinearLayout>

        <!-- Divider -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/colorDivider"
            android:layout_marginBottom="18dp" />

        <!-- Favorites header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="12dp">

            <TextView
                android:id="@+id/tvFavHeader"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Favorites"
                android:textSize="16sp"
                android:textColor="@color/colorTextPrimary"
                android:fontFamily="sans-serif-medium" />

            <Button
                android:id="@+id/btnAddFav"
                android:layout_width="wrap_content"
                android:layout_height="34dp"
                android:text="+ Save"
                android:textSize="12sp"
                android:textColor="@color/colorPrimary"
                android:textAllCaps="false"
                android:background="@color/colorBackground"
                android:paddingStart="12dp"
                android:paddingEnd="12dp" />
        </LinearLayout>

        <!-- Favorites container -->
        <LinearLayout
            android:id="@+id/containerFavs"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginBottom="22dp" />

        <!-- Battery Optimization -->
        <Button
            android:id="@+id/btnBatteryOpt"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:text="Disable Battery Optimization"
            android:textSize="13sp"
            android:textColor="@color/colorTextSecondary"
            android:textAllCaps="false"
            android:background="@color/colorInputBg"
            android:visibility="gone"
            android:layout_marginBottom="16dp" />

        <!-- Spacer -->
        <View
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <!-- ADB status -->
        <TextView
            android:id="@+id/tvAdbReady"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="ADB: Ready"
            android:textSize="11sp"
            android:textColor="@color/colorHint"
            android:layout_marginTop="8dp" />

    </LinearLayout>
</ScrollView>
