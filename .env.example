# Environment & Local Configuration Template
# Copy this file to .env for local environment overrides: cp .env.example .env

# Release Keystore Configuration
RELEASE_KEYSTORE_PATH=release.keystore
RELEASE_KEYSTORE_PASSWORD=your_keystore_password
RELEASE_KEY_ALIAS=your_key_alias
RELEASE_KEY_PASSWORD=your_key_password

# Local Android SDK Directory (if not defined in local.properties or system environment)
# ANDROID_SDK_ROOT=/opt/android-sdk

# Default Test Coordinates (Optional override)
# DEFAULT_LATITUDE=0.000000
# DEFAULT_LONGITUDE=0.000000
